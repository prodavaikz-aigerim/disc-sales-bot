# Скопируй этот файл в .env для локального запуска (или задай эти же
# переменные в настройках Railway -> Variables при деплое)

# Токен бота, который выдал @BotFather
BOT_TOKEN=

# Ссылка на твой Telegram-канал (кнопка в конце теста)
CHANNEL_URL=https://t.me/your_channel

# Ссылка на обучение/курс (вторая кнопка в конце теста)
COURSE_URL=https://your-course-link.example

# Необязательно: тексты на кнопках можно поменять
CHANNEL_BUTTON_TEXT=📣 Подписаться на канал
COURSE_BUTTON_TEXT=🎓 Записаться на обучение

# Путь к файлу постоянного хранения результатов (переживает перезапуск
# процесса, но НЕ переживает передеплой на Railway без подключённого volume)
PERSISTENCE_PATH=bot_persistence.pickle

# Финальный платный оффер (полный профиль психотипа + код мотивации)
# Текст цены — можно вписать конкретную сумму, например "9 990 ₸"
FULL_REPORT_PRICE=[цена уточняется]
FULL_REPORT_BUTTON_TEXT=💎 Получить мой полный профиль

# ПОЛУРУЧНОЙ РЕЖИМ ОПЛАТЫ (пока не подключён эквайринг Kaspi):
# пользователь оставляет email -> видит, куда платить -> присылает
# скриншот чека в чат с ботом -> тебе приходит уведомление с этим фото и
# кнопкой -> после подтверждения бот сам присылает отчёт в Telegram и на
# email.

# Ссылка на оплату — например, ссылка "удалённая оплата" из приложения
# Kaspi Pay с уже вписанной суммой. Если задать — пользователь увидит
# кнопку "Оплатить" сразу после того, как оставит email.
PAYMENT_LINK_URL=
PAYMENT_BUTTON_TEXT=💳 Оплатить
# Если ссылки на оплату нет — можно вместо неё показать номер телефона
# для перевода через Kaspi (используется только если PAYMENT_LINK_URL пуст)
KASPI_PHONE_NUMBER=

# Твой личный Telegram chat_id (не username!) — сюда приходят уведомления
# о новых заявках. Узнать свой chat_id: напиши боту @userinfobot, он
# пришлёт число вида 123456789.
ADMIN_CHAT_ID=

# Необязательно: твой Telegram username (без @) — после отправки чека
# пользователь увидит ссылку написать тебе лично напрямую, если захочет
# ускорить подтверждение.
ADMIN_USERNAME=

# Настройки почты для дублирования отчёта на email. Если оставить
# SMTP_HOST пустым — email просто не отправляется (отчёт всё равно уходит
# в Telegram), никаких ошибок это не вызывает.
# Пример для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER — твоя почта, SMTP_PASSWORD — "пароль приложения" Gmail
# (не обычный пароль от аккаунта! создаётся отдельно в настройках Google).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Психотип продавца

